{
	# 菀星设计局：模拟战势力列表用势力定义（当前无战役市场与舰队生成）。
	# 列表条目由原版 SimulatorPluginImpl.getCategories() 依据 custom.simulatorData.showInSimulator 生成；
	# 条目内舰船来自下方 shipRoles（按 knownShips 过滤，仅收录 stock variant，
	# 自动排除 no_sim / restricted / 空间站 hint），部署点数显示与排序为原版机制自带。

	"id":"asteria_directorate",
	"displayName":"菀星设计局",
	"displayNameWithArticle":"菀星设计局",
	# 原版英文 is/are 助词位：中文模板（如 MagicLib 赏金报酬文本）直接拼接该值，置空避免混入英文
	"displayNameIsOrAre":"",

	# 势力旗帜与方形纹章（纹章为旗帜中心裁切变体，构图对齐原版 410x256 / 256x256 规格）
	"logo":"graphics/factions/astd_faction.png",
	"crest":"graphics/factions/astd_faction_crest.png",

	# 主题色取旗帜淡紫，与 SIC 技能精英边框渐变同族（elite_astd_generic 采样 #8677FB）
	"color":[134,119,251,255],
	"baseUIColor":[134,119,251,255],
	"showInIntelTab":false,

	"names":{},
	"shipNameSources":{"ALL":1},

	# AI 核心头像池：失控 AI 主题舰队（赏金等）的军官头像来源；核心立绘无性别区分，两池同表
	"portraits":{
		"standard_male":[
			"graphics/portraits/astd_portrait_core_g.png",
			"graphics/portraits/astd_portrait_core_b.png",
			"graphics/portraits/astd_portrait_core_a.png",
			"graphics/portraits/astd_portrait_core_o.png",
			"graphics/portraits/astd_portrait_core_sp_blue.png",
			"graphics/portraits/astd_portrait_core_sp_copper.png",
			"graphics/portraits/astd_portrait_core_sp_violet.png",
			"graphics/portraits/astd_portrait_core_sp_yellow.png",
		],
		"standard_female":[
			"graphics/portraits/astd_portrait_core_g.png",
			"graphics/portraits/astd_portrait_core_b.png",
			"graphics/portraits/astd_portrait_core_a.png",
			"graphics/portraits/astd_portrait_core_o.png",
			"graphics/portraits/astd_portrait_core_sp_blue.png",
			"graphics/portraits/astd_portrait_core_sp_copper.png",
			"graphics/portraits/astd_portrait_core_sp_violet.png",
			"graphics/portraits/astd_portrait_core_sp_yellow.png",
		],
	},

	# 已知舰体口径：contents/data/hulls 下全部舰船 hull（astd_production / astd_unique / astd_automated
	# tag 覆盖全部舰船；战斗机与无人机 hull 不带这些 tag，天然排除）
	"knownShips":{
		"tags":["astd_production", "astd_unique", "astd_automated"],
		"hulls":[],
	},

	# 装配变体按原版 doctrine 角色分组列出；权重仅影响舰队抽取，模拟战列表不消费，统一取 10
	# 发布范围外舰体（决明 zw_001、逐电 xc_104）与唯一舰（星坠 xc_001 / 星翼 xc_002 / 密蒙 zw_002）不入池：
	# 原版舰队生成只从 shipRoles 条目采样（knownShips 仅作门槛），MagicLib 赏金增援填充同走此路径，
	# 唯一舰入池会被抽进普通巡逻队与赏金护航位，接受委托前的情报编成展示会误导玩家
	"shipRoles":{
		# 护卫舰：飞星 ×2
		"combatSmall":{
			"astd_lh_001_Standard":10,
			"astd_lh_001_Missile":10,
			"astd_lh_002_Standard":10,
			"astd_lh_002_Omega":10,
		},
		# 驱逐舰：列星 / 舜华
		"combatMedium":{
			"astd_xc_103_Standard":10,
			"astd_zw_101_Standard":10,
		},
		# 巡洋舰：熔壁
		"combatLarge":{
			"astd_xc_101_Standard":10,
		},
		# 主力舰：烽燧 / 飞蓬（航空战列舰，兼列 carrierLarge）
		"combatCapital":{
			"astd_xc_102_Standard":10,
			"astd_xc_102_Combat":10,
			"astd_zw_102_Hybrid":10,
			"astd_zw_102_Fighter":10,
			"astd_zw_102_Bomber":10,
		},
		# 相位：茑萝（驱逐舰级护航航母，兼列 carrierSmall）
		"phaseMedium":{
			"astd_zw_103_Standard":10,
			"astd_zw_103_Strike":10,
		},
		"carrierSmall":{
			"astd_zw_103_Standard":10,
			"astd_zw_103_Strike":10,
		},
		"carrierLarge":{
			"astd_zw_102_Hybrid":10,
			"astd_zw_102_Fighter":10,
			"astd_zw_102_Bomber":10,
		},
	},

	"custom":{
		"simulatorData":{
			"showInSimulator":true,
		},
	},
}
