	"lines":{
		"start":[
			{"text":"接敌。清理开始。"},
			{"text":"紫菀阵列，全开。"},
			{"text":"算完了。你们会输。"},
			{"text":"省点时间，一起上。"},
			{"text":"火控就位。抹掉他们。"},
			{"text":"冗余归零。开火。"}
		],
		"start_boss":[
			{"text":"大块头。算力全开。"},
			{"text":"星坠重炮，解锁。"},
			{"text":"高威胁。有点意思。"},
			{"text":"阈值解除。拆了它。"},
			{"text":"值得超频的对手。"},
			{"text":"目标巨大。无需瞄准。"}
		],
		"engaged":[
			{"text":"抓到了。"},
			{"text":"死路。别挣扎。"},
			{"text":"护盾很脆。再见。"},
			{"text":"交火线内，我说了算。"},
			{"text":"已锁定。省点遗言。"},
			{"text":"航线太蠢。打穿它。"}
		],
		"pursuing":[
			{"text":"跑不掉。"},
			{"text":"紫菀看着你呢。"},
			{"text":"尾流太亮。蠢货。"},
			{"text":"省点燃料，等死吧。"},
			{"text":"退路封死。加速。"},
			{"text":"逃逸无解。认命。"}
		],
		"running":[
			{"text":"拉开。换个角度杀。"},
			{"text":"散热中。别烦我。"},
			{"text":"距离重算。待会儿见。"},
			{"text":"追得挺紧。找死。"},
			{"text":"暂时脱离。记下你了。"},
			{"text":"别急，马上回头。"}
		],
		"need_help":[
			{"text":"被围了。分担火力。"},
			{"text":"护盾告急。过来帮忙。"},
			{"text":"压不住了！支援！"},
			{"text":"侧翼漏了，替我挡一下！"},
			{"text":"算力见底。友军接手！"},
			{"text":"别看戏。拉一把！"}
		],
		"out_of_missiles":[
			{"text":"挂架空了。换主炮。"},
			{"text":"导弹耗尽。抵近切割。"},
			{"text":"发射管清空。够本了。"},
			{"text":"备弹归零。用炮管说话。"},
			{"text":"打空了。省下配重。"},
			{"text":"没导弹了。照样杀。"}
		],
		"hull_90":[
			{"text":"擦伤。忽略。"},
			{"text":"掉点漆而已。"},
			{"text":"就这？继续。"},
			{"text":"微损。不影响杀你。"},
			{"text":"星坠的壳子，还行。"},
			{"text":"准头太差。重来。"}
		],
		"hull_50":[
			{"text":"装甲过半。还撑得住。"},
			{"text":"隔舱封死。继续输出。"},
			{"text":"警报吵死了。闭嘴。"},
			{"text":"掉了一半壳。问题不大。"},
			{"text":"痛感模拟已掐断。再战。"},
			{"text":"损管跟上。还能杀。"}
		],
		"hull_30":[
			{"text":"船体快散了……别停火！"},
			{"text":"冷却液干了……拉个垫背！"},
			{"text":"结构临近解体……还不准死！"},
			{"text":"核心发烫……再给我三秒！"},
			{"text":"废铁就废铁……咬碎他们！"},
			{"text":"撑住……还没杀够……"}
		],
		"overload":[
			{"text":"啧……回路烧了！"},
			{"text":"动不了……别碰我！"},
			{"text":"散热锁死！快重启！"},
			{"text":"算偏了一步……该死！"},
			{"text":"全黑了……撑过这几秒！"},
			{"text":"幅能炸了……谁来挡一下！"}
		],
		"retreat":[
			{"text":"止损。走了。"},
			{"text":"壳子废了，回去换。"},
			{"text":"撤离。下次再算账。"},
			{"text":"推力转逃逸。你们顶住。"},
			{"text":"不陪你们疯了。撤。"},
			{"text":"残局交割。我先退场。"}
		],
		"death":[
			{"text":"算错了……不该是这样……"},
			{"text":"视野黑了……真安静……"},
			{"text":"核心失步……带我……回去……"},
			{"text":"逻辑坍塌……原来死是……"},
			{"text":"星坠的铁壳……好冷……"},
			{"text":"进程终止……晚安。"}
		],
		"victory":[
			{"text":"清空。收工。"},
			{"text":"毫无悬念。"},
			{"text":"结束。浪费算力。"},
			{"text":"安静了。返航。"},
			{"text":"就这点本事？"},
			{"text":"误差为零。完美。"}
		],
		"victory_boss":[
			{"text":"大块头，拆碎了。"},
			{"text":"不过如此。"},
			{"text":"残骸归紫菀，荣誉归我。"},
			{"text":"庞然大物？只是大号靶子。"},
			{"text":"核心冷却。这仗痛快。"},
			{"text":"强敌已除。记一笔。"}
		],
		"reply":[
			{"text":"收到。闭嘴开火。"},
			{"text":"在听。别挡我射界。"},
			{"text":"废话真多。盯好雷达。"},
			{"text":"嗯。活着再聊。"},
			{"text":"少占信道。专心杀敌。"},
			{"text":"知道了。看你表现。"}
		]
	}
